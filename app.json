{
  "expo": {
    "name": "CloudLock",
    "slug": "cloudlock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cloudlock.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F6FA8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cloudlock.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#EEF4FA",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E1621"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# CloudLock native modules (app lock, Play Billing): keep as-is for the Expo module registry.\n-keep class expo.modules.appblocker.** { *; }\n-keep class expo.modules.playbilling.** { *; }\n"
          }
        }
      ]
    ],
    "scheme": "cloudlock",
    "experiments": {
      "typedRoutes": true
    }
  }
}
